# OpenAI model access
OPENAI_API_KEY=your-openai-api-key

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=hospital-rag-learning

# Use the endpoint matching your LangSmith account region.
# US: https://api.smith.langchain.com
# EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Required only for an organization-scoped key that can access multiple
# workspaces. Leave unset for a personal key or a single-workspace key.
# LANGSMITH_WORKSPACE_ID=your-workspace-id
